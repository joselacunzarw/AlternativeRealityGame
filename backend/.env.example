# ===========================================
# Expediente Abierto - Variables de Entorno
# ===========================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env al repositorio.

# --- JWT (OBLIGATORIO) ---
# Genera un secreto seguro con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google AI (Gemini, opcional) ---
GOOGLE_API_KEY=

# --- SMTP (Gmail App Password) ---
SMTP_USER=tu-correo@gmail.com
SMTP_APP_PASSWORD=

# --- Modo Desarrollo ---
# En true, el Guardián del Tiempo se desactiva y las respuestas llegan inmediatas.
DEV_MODE=true

# --- CORS (opcional) ---
# Orígenes permitidos separados por coma. Default: localhost:5173,localhost:5174
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Rate Limiting (opcional) ---
# Máximo de emails procesados por jugador por hora. Default: 20
# IMAP_RATE_LIMIT_PER_HOUR=20

# --- Rutas de base de datos (Docker) ---
# En desarrollo no hace falta setear estas variables (usan paths locales por defecto).
# En Docker, el docker-compose las setea automáticamente apuntando al volume.
# DB_PATH=./expediente_abierto_app.db
# DB_CHECKPOINT_PATH=./langgraph_checkpoints.sqlite
